        <name>Approve Fraud Review</name>
        <onclick/>
        <order>50</order>
        <script><![CDATA[// Approve the refund request - Case sync is handled by BR "Sync Refund Decision to Case"
current.setValue('decision', 'manually_approved');
current.setValue('amount_approved', current.getValue('amount_requested'));
current.setValue('decision_notes', 'Fraud review completed - approved by ' + gs.getUserDisplayName());
current.update();

// Update all linked fraud flags to approved
var flagGr = new GlideRecord('x_2145749_qc_fraud_flag');
flagGr.addQuery('refund_request', current.getUniqueValue());
flagGr.query();
while (flagGr.next()) {
    flagGr.setValue('review_status', 'approved');
    flagGr.update();
}

gs.addInfoMessage('Fraud review approved. Refund amount: ' + current.getValue('amount_approved'));
action.setRedirectURL(current);]]></script>
